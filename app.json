{
  "expo": {
    "name": "拉伸语音播报",
    "slug": "stretch-routine-v1",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/motion-core-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "splash": {
      "image": "./assets/motion-core-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#041B3D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.stretchroutine.v1",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#041B3D",
        "foregroundImage": "./assets/motion-core-adaptive-foreground.png",
        "backgroundImage": "./assets/motion-core-adaptive-background.png",
        "monochromeImage": "./assets/motion-core-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dc2542a5-0360-48c2-ba6e-fba4e209b945"
      }
    },
    "owner": "wanghoufan",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/motion-core-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#041B3D"
        }
      ]
    ]
  }
}
